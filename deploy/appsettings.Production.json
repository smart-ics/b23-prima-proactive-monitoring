{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PrIMADb": "Server=tcp:sql-prod.hospital.internal,1433;Database=PrIMA;User Id=prima_app;Password=<STRONG_APP_PASSWORD_PLACEHOLDER>;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true;Connection Timeout=30;",
    "SimrsDb": "Server=tcp:sql-simrs.hospital.internal,1433;Database=SIMRS;User Id=prima_readonly;Password=<STRONG_READONLY_PASSWORD_PLACEHOLDER>;ApplicationIntent=ReadOnly;Encrypt=True;TrustServerCertificate=False;Connection Timeout=15;"
  },
  "Jwt": {
    "SigningKey": "<REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_KEY_MIN_32_BYTES_BASE64_OR_PASSPHRASE>",
    "ExpirationHours": 12
  },
  "Ingestion": {
    "ApiKeys": [
      "<REPLACE_WITH_GLOBAL_FALLBACK_API_KEY_IF_NEEDED>"
    ]
  },
  "OperationalTimeZone": "Asia/Jakarta",
  "Supervisor": {
    "PollingIntervalSeconds": 60,
    "UnacknowledgedSlaTimeoutMinutes": 30
  },
  "Retention": {
    "InspectionRunsDays": 90
  },
  "SeedDemoData": false
}
