  "components": {
    "schemas": {
      "AddNoteRequest": {
        "required": [
          "noteText"
        ],
        "type": "object",
        "properties": {
          "noteText": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AssignIssueRequest": {
        "required": [
          "officerId"
        ],
        "type": "object",
        "properties": {
          "officerId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "DashboardFeedSummaryDto": {
        "required": [
          "criticalCount",
          "highCount",
          "openCount",
          "reopenedCount",
          "resolvedTodayCount"
        ],
        "type": "object",
        "properties": {
          "criticalCount": {
            "type": "integer",
            "format": "int32"
          },
          "highCount": {
            "type": "integer",
            "format": "int32"
          },
          "openCount": {
            "type": "integer",
            "format": "int32"
          },
          "reopenedCount": {
            "type": "integer",
            "format": "int32"
          },
          "resolvedTodayCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DismissIssueRequest": {
        "required": [
          "dismissalReason",
          "justificationRationale"
        ],
        "type": "object",
        "properties": {
          "dismissalReason": {
            "type": "string"
          },
          "justificationRationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DismissalRecordDto": {
        "required": [
          "dismissalReason",
          "dismissedBy",
          "id",
          "issueId",
          "isSuperseded",
          "justificationRationale",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issueId": {
            "type": "string",
            "format": "uuid"
          },
          "dismissalReason": {
            "type": "string"
          },
          "justificationRationale": {
            "type": "string"
          },
          "dismissedBy": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "isSuperseded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "FindingEvidenceItem": {
        "required": [
          "module"
        ],
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "sourceTable": {
            "type": "string",
            "nullable": true
          },
          "recordKeys": {
            "type": "string",
            "nullable": true
          },
          "debitTotal": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "creditTotal": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "varianceDelta": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "trace": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FindingItem": {
        "required": [
          "baseSeverity",
          "evidence",
          "targetEntityReference",
          "title"
        ],
        "type": "object",
        "properties": {
          "targetEntityReference": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "baseSeverity": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/FindingEvidenceItem"
          }
        },
        "additionalProperties": false
      },
      "FindingResultItem": {
        "required": [
          "action",
          "correlationKey",
          "issueId",
          "occurrenceId",
          "occurrenceNumber"
        ],
        "type": "object",
        "properties": {
          "correlationKey": {
            "type": "string"
          },
          "issueId": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "occurrenceId": {
            "type": "string",
            "format": "uuid"
          },
